# 复制为 .env 后，Docker Compose 会自动读取；本地直接运行 Python 请用 *.example.json 模板，
# 或手动设置环境变量（.env 已被 .gitignore 排除）。
# 也可以不建文件，直接在系统环境变量 / Docker secrets / CI Secrets 里注入。

# ---- DeepSeek（改文） ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 飞书多维表格（选题录入 + 数据看板） ----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_BASE_URL=https://open.feishu.cn

# ---- 飞星 UPMee（TikTok 发布） ----
FEIXING_API_KEY=
FEIXING_TEAM_ID=

# ---- 路径覆盖（可选；Docker / 服务器上建议全部指向挂载卷） ----
# NOVEL_CONFIG=/app/config/config.json
# NOVEL_DB=/data/state.db
# NOVEL_AUDIO_DIR=/data/audio
# NOVEL_BACKGROUND_DIR=/data/background
# NOVEL_OUTPUT_DIR=/data/output
# NOVEL_ICON_DIR=/data/icons
# NOVEL_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# NOVEL_FFMPEG=/usr/bin/ffmpeg
# NOVEL_FFPROBE=/usr/bin/ffprobe
